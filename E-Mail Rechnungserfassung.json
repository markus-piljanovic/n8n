    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ===== Find Invoice PDFs =====\n// Zweck: Pro Mail das beste PDF aus den Anhängen auswählen.\n// Ergebnis: json.hatPDF (true/false), json.dateiname, binary.attachment_0 (nur das gewählte PDF)\n\n// --- Konstanten ---\n// Dateinamen-Wörter, die auf KEINE Rechnung hindeuten (Fallback-Ausschluss)\nconst muell = /(widerruf|agb|storno|retoure|return|terms|datenschutz|hinweis|newsletter)/i;\n// Dateinamen-Wörter, die auf eine Rechnung hindeuten (haben Vorrang)\nconst gut = /(rechnung|invoice|beleg|quittung|bill|receipt)/i;\n\n// --- 1. Alle PDF-Anhänge der Mail sammeln ---\n// PDF = MIME-Typ application/pdf ODER Dateiendung .pdf\nconst binary = $input.item.binary || {};\nconst pdfKeys = Object.keys(binary).filter(k => {\n  const a = binary[k];\n  return a.mimeType === 'application/pdf' || (a.fileName || '').toLowerCase().endsWith('.pdf');\n});\n\n// --- 2. Bestes PDF wählen ---\n// Erst: Dateiname enthält ein \"Rechnungs\"-Wort. Sonst: erstes PDF ohne \"Müll\"-Wort.\nconst key = pdfKeys.find(k => gut.test(binary[k].fileName || ''))\n         || pdfKeys.find(k => !muell.test(binary[k].fileName || ''));\n\n// --- 3a. Kein brauchbares PDF: Flags auf \"nein\" setzen, Binary leeren ---\nif (!key) {\n  $input.item.binary = {};\n  $input.item.json.hatPDF = false;\n  $input.item.json.dateiname = '';\n  return $input.item;\n}\n\n// --- 3b. PDF gefunden: als attachment_0 durchreichen, Flags setzen ---\nconst fileName = binary[key].fileName || '';\n$input.item.binary = { attachment_0: binary[key] };\n$input.item.json.hatPDF = true;\n$input.item.json.dateiname = fileName;\nreturn $input.item;"
      },
      "id": "cc5afdba-e7d4-467e-a4e8-05a1e6114ba9",
      "name": "Find Invoice PDFs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
